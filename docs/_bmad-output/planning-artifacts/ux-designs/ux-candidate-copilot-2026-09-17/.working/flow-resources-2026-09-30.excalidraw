    {
      "id": "resource-20260930-0181",
      "type": "text",
      "x": 916,
      "y": 874,
      "width": 610.4699999999999,
      "height": 26.25,
      "angle": 0,
      "strokeColor": "#444444",
      "backgroundColor": "transparent",
