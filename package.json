{
  "name": "candidate-copilot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.22.0",
    "npm": "11.19.1"
  },
  "scripts": {
    "dev:frontend": "vite",
    "dev:worker": "CI=true WRANGLER_SEND_METRICS=false wrangler dev --local --persist-to .wrangler/state --ip 127.0.0.1 --port 8787 --inspector-ip 127.0.0.1 --env-file /dev/null",
    "db:init": "node scripts/local-d1.mjs init",
    "db:check": "node scripts/local-d1.mjs check",
    "db:types": "node scripts/local-d1.mjs types",
    "test:d1": "playwright test d1.spec.ts",
    "test:smoke": "playwright test",
    "typecheck": "tsc -p tsconfig.frontend.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.tooling.json",
    "test": "bash tests/toolchain/check-workstation.test.sh && vitest run",
    "build": "npm run build:frontend && npm run build:worker",
    "build:frontend": "vite build",
    "build:worker": "node -e \"require('node:fs').rmSync('dist/worker', { recursive: true, force: true })\" && CI=true WRANGLER_SEND_METRICS=false wrangler deploy --dry-run --env-file /dev/null --outdir dist/worker"
  },
  "dependencies": {
    "hono": "4.13.13",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261019.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "wrangler": "4.151.2"
  }
}
